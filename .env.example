# Copy this file to .env and fill in your own values. Never commit .env.
ALPACA_API_KEY=your_paper_key_id
ALPACA_SECRET_KEY=your_paper_secret
# Optional: without it the bot uses a simple rule-based analyst instead of AI.
OPENROUTER_API_KEY=
# Must be a model that accepts images. Cheaper option: google/gemini-3.6-flash
AI_MODEL=anthropic/claude-sonnet-5
# trend = daily 200-day average rule (default); intraday = original 15-minute chart strategy
STRATEGY=trend
# In trend mode, let the AI veto buys (needs OPENROUTER_API_KEY). It can never add trades.
AI_VETO=true
# Keep true until you have watched a few dry runs.
DRY_RUN=true
